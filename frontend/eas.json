{
    "cli": {
        "version": ">= 25.0.0",
        "appVersionSource": "remote"
    },
    "build": {
        "base": {
            "node": "24.22.0"
        },
        "development": {
            "extends": "base",
            "environment": "development",
            "distribution": "internal",
            "env": {
                "APP_VARIANT": "development"
            },
            "android": {
                "gradleCommand": ":app:assembleDebug"
            }
        },
        "preview": {
            "extends": "base",
            "environment": "preview",
            "distribution": "internal",
            "autoIncrement": true,
            "env": {
                "APP_VARIANT": "preview",
                "EXPO_PUBLIC_API_TIMEOUT_MS": "90000"
            },
            "android": {
                "buildType": "apk"
            }
        },
        "production": {
            "extends": "base",
            "environment": "production",
            "autoIncrement": true,
            "env": {
                "APP_VARIANT": "production"
            },
            "android": {
                "buildType": "app-bundle"
            }
        }
    }
}
