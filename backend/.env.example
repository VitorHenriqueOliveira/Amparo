DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
# Gere um segredo aleatório com pelo menos 32 bytes; não reutilize o segredo exposto.
JWT_SECRET=
PORT=3000
NODE_ENV=development
# Origens web permitidas. No celular, informe a origem web apenas se utilizar navegador.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Número de proxies confiáveis na hospedagem; deixe 0 na execução local.
TRUST_PROXY_HOPS=0
